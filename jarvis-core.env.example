# Copy to .env.jarvis-core (ignored by Git). Never commit real credentials.
# Remote HTTPS API compatible with Chat Completions + image_url + JSON mode.
JARVIS_CORE_BASE_URL=https://api.openai.com/v1
JARVIS_CORE_API_KEY=
# Set the vision-capable model identifier offered by your provider.
JARVIS_CORE_MODEL=
JARVIS_CORE_MIN_AVAILABLE_MB=1536
JARVIS_CORE_MAX_STEPS=10
JARVIS_CORE_TIMEOUT=120
JARVIS_CORE_REQUEST_TIMEOUT=25
JARVIS_CORE_HEADLESS=false
